# Environment Variables — Medical Supply Intelligence Backend
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────
# Server
# ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=singularity_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MAX=10

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
# Set to your Frontend URL in production (e.g. http://localhost:5173)
CORS_ORIGIN=*

# ─────────────────────────────────────────
# AI Service (BackendAI)
# Contract not yet defined — update when AI Team provides URL
# ─────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─────────────────────────────────────────
# n8n Automation
# Contract not yet defined — update when Automation Team provides URL
# ─────────────────────────────────────────
N8N_TRIGGER_URL=http://localhost:5678/webhook/your-workflow-id
